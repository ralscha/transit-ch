[Unit]
Description=Refresh Transit CH platform data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=transit-ch
Group=transit-ch
WorkingDirectory=/opt/transit-ch
ExecStart=/opt/transit-ch/transit-ch-importer -out /opt/transit-ch/platforms.bin
# Only runs after a successful import. The + grants root to this command alone;
# the downloader runs as transit-ch. An intentionally stopped API stays stopped.
ExecStartPost=+/usr/bin/systemctl try-restart transit-ch.service
TimeoutStartSec=15min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The importer atomically replaces the snapshot using a temporary sibling file.
# Install this directory as root:transit-ch mode 1775; keep binaries root-owned.
ReadWritePaths=/opt/transit-ch
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
