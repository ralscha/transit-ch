transit-ch.rasc.ch {
	root * /opt/transit-ch/dist/transit-ch/browser

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		X-XSS-Protection "0"
	}

	handle /traffic-point-v2/* {
		reverse_proxy 127.0.0.1:34341
	}
	handle {
		route {
			# Set cache headers after rewriting SPA routes to index.html.
			try_files {path} /index.html
			header Cache-Control "public, max-age=0, must-revalidate"

			# Only Angular bundles with content hashes are immutable.
			@hashedBundles path_regexp hashedBundles ^/[^/]+-[A-Z0-9]{8}\.(js|css)$
			header @hashedBundles Cache-Control "public, max-age=31536000, immutable"

			@sw path /ngsw.json /ngsw-worker.js /safety-worker.js /worker-basic.min.js
			header @sw Cache-Control "no-cache, no-store, must-revalidate"

			file_server {
				precompressed br gzip zstd
			}
		}
	}
}
